{
  "SpreadsheetMaps": [
    {
      "Worksheet": "Quarterly Return Template",
      "DataMaps": [
        {
          "Name": "DataYear",
          "Cell": "B5"
        }
      ],
      "DataColumns": [
        {
          "ColumnName": "A",
          "HasData": false
        },
        {
          "ColumnName": "B",
          "HasData": true
        }
      ]
    },
    {
      "Worksheet": "Cover",
      "DataMaps": [
        {
          "Name": "LocalAuthority",
          "Cell": "B13"
        }
      ]
    }
  ],
  "Workflows": [
    {
      "WorkflowName": "Quarterly Return Template",
      "Rules": [
        {
          "RuleName": "Rule1",
          "Expression": "!string.IsNullOrEmpty(data.DataYear) && Regex.IsMatch(data.DataYear, \"^20\\\\d{2}-\\\\d{2} Quarterly Data$\") && int.Parse(data.DataYear.Substring(5, 2)) + 2000 - int.Parse(data.DataYear.Substring(0, 4)) == 1",
          "ErrorMessage": "Data Year must be of format \"20xx-yy Quarterly Data\" and represent consecutive years"
        }
      ]
    },
    {
      "WorkflowName": "Cover",
      "Rules": [
        {
          "RuleName": "Rule1",
          "Expression": "!string.IsNullOrEmpty(data.LocalAuthority) && string.Equals(data.LocalAuthority.Split(' ')[0], localAuthority.Code, StringComparison.OrdinalIgnoreCase)",
          "ErrorMessage": "Local Authority must match"
        }
      ]
    }
  ]
}
