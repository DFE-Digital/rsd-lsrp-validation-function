{
  "SpreadsheetMaps": [
    {
      "Worksheet": "Quarterly Returns",
      "DataMaps": [
        {
          "Name": "DataYear",
          "Cell": "B5"
        }
      ],
      "DataColumns": [
        {
          "ColumnName": "A",
          "HasData": false
        },
        {
          "ColumnName": "B",
          "HasData": true
        }
      ]
    },
    {
      "Worksheet": "Guidance"
    },
    {
      "Worksheet": "Cover",
      "DataMaps": [
        {
          "Name": "LocalAuthority",
          "Cell": "B13"
        }
      ]
    }
  ],
  "Workflows": [
    {
      "WorkflowName": "Quarterly Returns",
      "Rules": [
        {
          "RuleName": "Rule1",
          "Expression": "Utils.MatchRegex(data.DataYear, \"^20\\\\d{2}-\\\\d{2} Data$\")",
          "ErrorMessage": "Data Year must be of format \"20xx-yy Data\""
        }
      ]
    },
    {
      "WorkflowName": "Cover",
      "Rules": [
        {
          "RuleName": "Rule1",
          "Expression": "data.LocalAuthority = user.LocalAuthority",
          "ErrorMessage": "Local Authority must match"
        }
      ]
    }
  ]
}
