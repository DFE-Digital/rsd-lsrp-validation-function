{
  "ValidationOptions": {
    "SpreadsheetMaps": [
      {
        "Worksheet": "Quarterly Returns",
        "DataMaps": [
          {
            "Name": "DataYear",
            "Cell": "B5"
          }
        ],
        "DataColumns": [
          {
            "ColumnName": "A",
            "HasData": false
          },
          {
            "ColumnName": "B",
            "HasData": true
          }
        ]
      },
      {
        "Worksheet": "Guidance"
      },
      {
        "Worksheet": "Cover"
      }
    ],
    "Workflows": [
      {
        "WorkflowName": "Quarterly Returns",
        "Rules": [
          {
            "RuleName": "Rule1",
            "Expression": "Utils.MatchRegex(DataYear, \"^20\\\\d{2}-\\\\d{2} Data$\")",
            "ErrorMessage": "DataYear must be of format \"20xx-yy Data\""
          }
        ]
      }
    ]
  }
}
