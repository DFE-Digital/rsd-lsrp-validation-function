{
  "ValidationOptions": {
    "SpreadsheetMaps": [
      {
        "Worksheet": "Quarterly Returns",
        "DataMaps": [
          {
            "Name": "DataYear",
            "Cell": "B5"
          }
        ],
        "DataColumns": [
          {
            "ColumnName": "A",
            "HasData": false
          },
          {
            "ColumnName": "B",
            "HasData": true
          }
        ]
      },
      {
        "Worksheet": "Guidance"
      },
      {
        "Worksheet": "Cover",
        "DataMaps": [
          {
            "Name": "LocalAuthority",
            "Cell": "B13"
          }
        ]
      }
    ],
    "Workflows": [
      {
        "WorkflowName": "Quarterly Returns",
        "Rules": [
          {
            "RuleName": "Rule1",
            "Expression": "Utils.MatchRegex(input1.DataYear, \"^20\\\\d{2}-\\\\d{2} Data$\")",
            "ErrorMessage": "DataYear must be of format \"20xx-yy Data\""
          }
        ]
      },
      {
        "WorkflowName": "Cover",
        "Rules": [
          {
            "RuleName": "Rule1",
            "Expression": "input1.LocalAuthority = input2.LocalAuthority",
            "ErrorMessage": "Local Authority must match"
          }
        ]
      }
    ]
  }
}
