{
  "SpreadsheetVersion": "September-2026",
  "ValidationOptions": {
    "SpreadsheetMaps": [
      {
        "Worksheet": "Quarterly Returns",
        "DataMaps": [
          {
            "Name": "DataYear",
            "Cell": "B5"
          }
        ],
        "DataColumns": [
          {
            "ColumnName": "A",
            "HasData": false
          },
          {
            "ColumnName": "B",
            "HasData": true
          }
        ]
      },
      {
        "Worksheet": "Cover",
        "ErrorMessage": "Spreadsheet must contain the Cover tab\nThe Cover tab is missing from your file or has been renamed\nAction required: Open your spreadsheet and make sure the Cover tab is present. It must follow the naming format exactly with no spelling mistakes or additional spaces\n",
        "DataMaps": [
          {
            "Name": "LocalAuthority",
            "Cell": "B13"
          }
        ]
      }
    ],
    "Workflows": [
      {
        "WorkflowName": "Quarterly Returns",
        "Rules": [
          {
            "RuleName": "Rule1",
            "Expression": "Utils.CheckYear(data.DataYear)",
            "ErrorMessage": "Data Year must be of format \"20xx-yy Data\" and represent consecutive years"
          }
        ]
      },
      {
        "WorkflowName": "Cover",
        "Rules": [
          {
            "RuleName": "Rule1",
            "Expression": "data.LocalAuthority = localAuthority.ToString()",
            "ErrorMessage": "Local Authority must match"
          }
        ]
      }
    ]
  }
}
